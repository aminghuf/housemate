# Telegram bot token from @BotFather
BOT_TOKEN=

# Numeric ID of the household's Telegram channel (bot must be an admin there)
# e.g. -1001234567890
HOUSE_CHANNEL_ID=

# Optional: invite link shown to non-members who try to /start the bot
HOUSE_CHANNEL_INVITE_LINK=

# Comma-separated Telegram user IDs allowed to use admin commands
ADMIN_IDS=

# IANA timezone used for all scheduling
TIMEZONE=Europe/Rome

# Path to the SQLite database file
DB_PATH=/data/housemate.db

# How often (hours) membership is re-verified for an already-registered user
MEMBERSHIP_RECHECK_HOURS=6

# Bot run mode: "polling" (default) or "webhook"
RUN_MODE=polling
